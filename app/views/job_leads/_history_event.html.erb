<%# locals: (status:, label:, field: nil, time: nil, previous_time: nil, action: nil, last: false) %>

<% placeholder = field.nil? %>

<li class="relative grid grid-cols-[auto_minmax(0,1fr)] gap-x-3.5 <%= "pb-6" unless last %>">
  <% unless last %>
    <span class="absolute left-3.75 top-9 bottom-0 w-px bg-neutral-200 dark:bg-neutral-800" aria-hidden="true"></span>
  <% end %>

  <% if placeholder %>
    <span class="grid place-items-center size-7.5 rounded-full border border-dashed border-neutral-300 dark:border-neutral-700 text-muted" aria-hidden="true">
      <%= icon_for_status status, class: "size-4 shrink-0" %>
    </span>
  <% else %>
    <span class="tag tag-<%= status %> grid place-items-center size-7.5 p-0 rounded-full" aria-hidden="true">
      <%= icon_for_status status, class: "size-4 shrink-0" %>
    </span>
  <% end %>

  <div class="min-w-0">
    <div class="flex items-start justify-between gap-2 min-h-7.5 <%= "mb-2" unless placeholder %>">
      <div class="min-w-0 pt-0.5">
        <%= label %>
        <% if placeholder %>
          <p class="text-xs text-muted mt-0.5">Not yet</p>
        <% elsif time %>
          <p class="mt-0.5 flex flex-wrap items-center text-xs text-muted tabular-nums divide-dot divide-dot-gap-1.5 divide-dot-size-0.5 divide-dot-neutral-400 dark:divide-dot-neutral-600">
            <span class="inline-flex items-center"><%= local_time_short time %></span>
            <% if previous_time && time >= previous_time %>
              <span class="inline-flex items-center"><%= time - previous_time < 1.minute ? "same time" : "#{distance_of_time_in_words(previous_time, time)} later" %></span>
            <% end %>
          </p>
        <% end %>
      </div>
      <% if action %>
        <div class="self-end shrink-0">
          <%= action %>
        </div>
      <% end %>
    </div>
    <%= field %>
  </div>
</li>
