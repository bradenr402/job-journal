<%# locals: () %>

<%# A vertical list of filter dropdowns: above the items on small screens, a sticky sidebar from @3xl up. %>
<aside id="job-lead-filters" class="filter-panel">
  <div class="filter-panel-content">
    <%= render "shared/clear_filters", filters: @filters, path: job_leads_path(job_lead_state: "all") %>

    <%= render "shared/sort_options", filters: @filters %>

    <div class="filter-group">
      <%
        state_icons = {
          all: "layers",
          active: "check-circle",
          archived: "archive"
        }.stringify_keys
      %>

      <%= render "shared/filter_dropdown",
        filters: @filters,
        name: :state,
        icon_name: "status",
        off: "all",
        context: "job-leads-state",
        options: @filters.class.options_for(:state).without("all").map { |state| { value: state, icon: state_icons[state] } }
      %>
    </div>

    <div class="filter-group">
      <%= render "shared/filter_dropdown",
        filters: @filters,
        name: :status,
        icon_name: "timeline",
        context: "job-leads-status",
        options: @filters.class.options_for(:status).map { |status| { value: status, icon: icon_name_for_status(status) } }
      %>
    </div>

    <% if @sources.any? %>
      <div class="filter-group">
        <%= render "shared/filter_dropdown",
          filters: @filters,
          name: :source,
          icon_name: "globe",
          context: "job-leads-source",
          selected: @sources.find { it.casecmp? @filters.source.to_s },
          options: @sources.map { |source| { value: source, label: source, icon: "globe" } }
        %>
      </div>
    <% end %>

    <% if @tags.any? %>
      <div class="filter-group">
        <%= render "shared/filter_dropdown",
          filters: @filters,
          name: :tag_names,
          label: "Tags",
          icon_name: "tag",
          context: "job-leads-tags",
          options: @tags.map { |tag| { value: tag.name, label: tag.name, icon: "tag" } }
        %>
      </div>
    <% end %>
  </div>
</aside>
