<%# locals: () %>

<div>
  <div class="mb-4">
    <h2 class="subheading">Danger Zone</h2>
    <p class="text-sm text-muted mt-1">These actions are immediate and can&#8217;t be undone. Proceed carefully.</p>
  </div>
  <div class="space-y-6">
    <div>
      <%= button_to "Reset All Settings", reset_settings_path(tab: "danger_zone"), method: :patch, data: { turbo_confirm: "Are you sure you want to reset all your settings to their defaults?" }, class: "btn btn-destructive btn-muted w-full sm:w-auto" %>
      <p class="text-xs text-muted mt-1">Restore every setting to its default value. Your job leads, interviews, and notes are not affected.</p>
    </div>
    <div>
      <h3 id="delete-account-heading" class="font-semibold text-light mb-2">Delete Account</h3>
      <%= render "users/delete_account", heading: false %>
    </div>
  </div>
</div>
