<%# locals: (form:, setting_path:, options:, label: setting_path.last.to_s.titleize, current_value: @settings.dig(*setting_path), help_text: nil) %>

<%
  field_id   = setting_path.join("_")
  field_name = "settings#{setting_path.map { |part| "[#{part}]" }.join}"
%>

<div role="radiogroup" aria-labelledby="<%= field_id %>_label">
  <p id="<%= field_id %>_label" class="form-label"><%= label %></p>

  <div class="segmented-control mt-2">
    <span class="segmented-control-pill" aria-hidden="true"></span>

    <% options.each do |option| %>
      <% text, value, icon_name = option.values_at :text, :value, :icon %>

      <label class="segmented-control-option group">
        <%= form.radio_button field_id, value, name: field_name, id: "#{field_id}_#{value}", checked: current_value == value, class: "sr-only peer" %>
        <span class="segmented-control-content">
          <%= icon icon_name, class: "size-5 shrink-0 in-peer-checked:hidden" %>
          <%= icon "#{icon_name}-filled", class: "size-5 shrink-0 not-in-peer-checked:hidden" %>
          <%= tag.span text %>
        </span>
      </label>
    <% end %>
  </div>

  <%= tag.p help_text.html_safe, class: "text-muted text-xs mt-1" if help_text %>
</div>
