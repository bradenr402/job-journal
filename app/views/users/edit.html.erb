<% content_for :title, "Edit Account" %>

<div class="sm:w-7/8 w-full mx-auto">
  <div class="mb-4 flex flex-wrap gap-2 items-center justify-between">
    <%= link_to account_path, class: "btn btn-sm btn-secondary btn-muted gap-1.5 [view-transition-name:back-btn]" do %>
      <%= icon "arrow-left", class: "size-3.5 shrink-0" %>
      <span>Back to Account</span>
    <% end %>
  </div>

  <div class="mb-6">
    <h1 class="heading">Edit Account</h1>
    <p class="text-sm text-muted mt-1 text-pretty">Update your profile and how you sign in to JobJournal.</p>
  </div>

  <%= form_with model: @user, url: account_update_path, method: :patch, data: {
        controller: "credentials-confirm",
        credentials_confirm_saved_email_value: @user.email_address_in_database,
        credentials_confirm_force_visible_value: @user.errors[:current_password].any?
      } do |form| %>
    <%= render "components/errors", resource: @user %>

    <div class="space-y-10">
      <section aria-labelledby="profile-heading">
        <div class="mb-4">
          <h2 id="profile-heading" class="subheading">Profile</h2>
          <p class="text-sm text-muted mt-1 text-pretty">You sign in with your email. Changing it signs you out on other devices and notifies your old address.</p>
        </div>

        <div class="space-y-5">
          <div>
            <%= form.label :name, class: "form-label" %>
            <%= form.text_field :name, autocomplete: "name", placeholder: "Jane Smith", class: "form-input" %>
          </div>

          <div>
            <%= form.label :email_address, "Email Address", class: "form-label" %>
            <%= form.text_field :email_address, inputmode: "email", autocomplete: "username", autocapitalize: "none", spellcheck: false, required: true, placeholder: "jane@example.com", class: "form-input", data: { credentials_confirm_target: "email", action: "input->credentials-confirm#update" } %>
          </div>
        </div>
      </section>

      <section aria-labelledby="password-heading">
        <div class="mb-4">
          <h2 id="password-heading" class="subheading">Password</h2>
          <p class="text-sm text-muted mt-1 text-pretty">Leave blank to keep your current password. Changing it signs you out on other devices.</p>
        </div>

        <div class="@container" data-controller="password-requirements" data-password-requirements-min-length-value="<%= User::PASSWORD_MIN_LENGTH %>">
          <div class="grid grid-cols-1 @xl:grid-cols-2 gap-5">
            <div>
              <%= render "shared/password_field", form:, attribute: :password, label: "New Password", autocomplete: "new-password",
                    data: { credentials_confirm_target: "password", password_requirements_target: "password", action: "input->credentials-confirm#update input->password-requirements#update" } %>
              <%= render "shared/password_requirement", target: "length", text: "At least #{User::PASSWORD_MIN_LENGTH} characters" %>
            </div>

            <div>
              <%= render "shared/password_field", form:, attribute: :password_confirmation, label: "Confirm New Password", autocomplete: "new-password",
                    data: { password_requirements_target: "confirmation", action: "input->password-requirements#update" } %>
              <%= render "shared/password_requirement", target: "match", text: "Passwords match", hidden: true %>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="mt-8" data-credentials-confirm-target="confirmation">
      <div class="rounded-xl border border-neutral-300 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 p-3.75">
        <div class="flex items-start gap-1.5 mb-3">
          <%= icon "security", class: "size-4.5 shrink-0 mt-0.5 text-normal" %>
          <p class="text-sm text-light text-pretty">Enter your current password to change your email or password.</p>
        </div>
        <%= render "shared/password_field", form:, attribute: :current_password, label: "Current Password", autocomplete: "current-password", data: { credentials_confirm_target: "currentPassword" } %>
      </div>
    </div>

    <div class="sticky-form-footer mt-8 flex flex-wrap items-center gap-2">
      <%= form.submit "Save Changes", class: "btn btn-primary w-full sm:w-auto" %>
      <%= link_to "Cancel", account_path, class: "btn btn-secondary w-full sm:w-auto" %>
    </div>
  <% end %>

  <%= render "users/delete_account", class: "mt-12" %>
</div>
