<% content_for :title, "Your Account" %>

<%
  stats = [
    { key: :job_leads, label: "Job Lead", icon: "briefcase" },
    { key: :applications, label: "Application", icon: "application" },
    { key: :interviews, label: "Interview", icon: "interview" },
    { key: :offers, label: "Offer", icon: "offer" },
    { key: :notes, label: "Note", icon: "quill" }
  ]

  quick_links = [
    { label: "Settings", description: "Appearance, goals, follow-ups, and auto-archiving", icon: "settings", path: settings_path },
    { label: "Security", description: "#{pluralize(@sessions_count, "active session")}", icon: "security", path: security_path },
    { label: "Manage Tags", description: @tags_count.zero? ? "No tags yet" : pluralize(@tags_count, "tag"), icon: "tag", path: tags_path },
    { label: "Archived Job Leads", description: @archived_count.zero? ? "Nothing archived" : "#{@archived_count} archived", icon: "archive", path: job_leads_path(job_lead_state: "archived") },
    { label: "Export Your Data", description: "Download as JSON or CSV", icon: "file-export", path: account_export_path }
  ]
%>

<div class="sm:w-7/8 w-full mx-auto">
  <div class="mb-4 flex flex-wrap gap-2 items-center justify-between">
    <%= link_to dashboard_path, class: "btn btn-sm btn-secondary btn-muted gap-1.5 [view-transition-name:back-btn]" do %>
      <%= icon "arrow-left", class: "size-3.5 shrink-0" %>
      <span>Back Home</span>
    <% end %>
  </div>

  <div class="<%= class_names "section-stack", "section-stack-dividers": minimal_style? %>">
    <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
      <div class="min-w-0 flex items-center gap-4">
        <%= render "users/avatar", user: @user, size: "size-14 text-xl" %>
        <div class="min-w-0">
          <h1 class="heading break-words"><%= @user.name.presence || @user.email_address %></h1>
          <p class="mt-1 flex flex-wrap items-center text-sm text-muted divide-dot divide-dot-gap-1.5 divide-dot-size-0.5 divide-dot-neutral-400 dark:divide-dot-neutral-600">
            <% if @user.name? %>
              <span class="inline-flex items-center min-w-0 break-all"><%= @user.email_address %></span>
            <% end %>
            <span class="inline-flex items-center gap-1">Joined <%= local_date_short @user.created_at %></span>
            <% if @search_days %>
              <span class="inline-flex items-center"><%= @hired_at ? "Hired after" : "Searching for" %> <%= pluralize(@search_days, "day") %></span>
            <% end %>
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <%= link_to edit_account_path, class: "btn btn-secondary" do %>
          <%= icon "user-edit", class: "size-5 shrink-0" %>
          <span>Edit Account</span>
        <% end %>

        <%= button_to session_path, method: :delete, class: "btn btn-destructive btn-muted" do %>
          <%= icon "logout", class: "size-5 shrink-0" %>
          <span>Sign Out</span>
        <% end %>
      </div>
    </div>

    <section aria-labelledby="account-stats-heading">
      <div class="mb-4">
        <h2 id="account-stats-heading" class="subheading">Stats</h2>
        <p class="text-sm text-muted mt-1 text-pretty">A quick summary of your job search activity.</p>
      </div>

      <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-5">
        <% stats.each do |stat| %>
          <% count = @stats[stat[:key]] %>
          <div class="flex flex-col min-w-0">
            <dt class="flex items-center gap-1.5 text-sm text-muted">
              <%= icon stat[:icon], class: "size-3.75 shrink-0" %>
              <span><%= stat[:label].pluralize(count) %></span>
            </dt>
            <dd class="order-first mb-0.5 text-2xl font-bold text-normal tabular-nums"><%= number_with_delimiter count %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <section aria-labelledby="account-links-heading">
      <div class="mb-4">
        <h2 id="account-links-heading" class="subheading">Manage</h2>
        <p class="text-sm text-muted mt-1 text-pretty">Customize JobJournal and keep your account secure.</p>
      </div>

      <div class="@container">
        <div class="<%= collection_layout_class_names layout: "grid", count: quick_links.size, size: :medium %>">
          <% quick_links.each do |link| %>
            <div class="group relative <%= item_layout_class_names %> flex items-center gap-3">
              <%= blanket_link link[:path], label: link[:label] %>

              <div class="grid place-items-center size-10 shrink-0 rounded-full bg-neutral-100 dark:bg-neutral-800 group-hover:bg-neutral-200 dark:group-hover:bg-neutral-700 transition-colors duration-80">
                <%= icon link[:icon], class: "size-6 shrink-0" %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="font-semibold"><%= link[:label] %></p>
                <p class="text-xs text-muted"><%= link[:description] %></p>
              </div>
              <%= icon "chevron-right", class: "size-4.5 shrink-0 text-muted" %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  </div>
</div>
