<% content_for :title, "Forgot Password" %>
<% content_for :tagline do %>It <em>happens</em>.<% end %>
<% content_for :tagline_fact, "Reset links expire after 15 minutes, and nothing changes until you use one." %>

<div data-controller="email-handoff">
  <%= render "shared/auth_header", title: "Reset your password", subtitle: "Enter your email address and we’ll send you a link to choose a new one." %>

  <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email Address", class: "form-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, value: params[:email_address], class: "form-input", data: { email_handoff_target: "email" } %>
    </div>

    <%= form.submit "Send Reset Link", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-8 text-sm text-soft text-center">
    Remembered it? <%= link_to "Back to sign in", new_session_path, class: "btn-link btn-link-primary", data: { action: "email-handoff#carry" } %>
  </p>
</div>
