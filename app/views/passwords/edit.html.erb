<% content_for :title, "Update Password" %>

<div class="card">
  <h1 class="subheading">Update Your Password</h1>
  <p class="text-soft">Enter your new password below.</p>

  <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
    <%= render "shared/new_password_fields", form:, placeholder: "Enter new password", confirmation_placeholder: "Repeat new password" %>

    <div class="flex w-full items-center justify-between">
      <%= form.submit "Save Password", class: "grow btn btn-primary" %>
    </div>
  <% end %>

  <div class="flex flex-col items-center gap-2 mt-4">
    <%= link_to "Back to sign in", new_session_path, class: "btn-link btn-link-muted" %>
  </div>
</div>
