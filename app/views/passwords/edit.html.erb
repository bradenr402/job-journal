<% content_for :title, "Choose a New Password" %>
<% content_for :tagline, "Saving your new password signs you out on every other device." %>

<%= render "shared/auth_header", title: "Choose a new password", subtitle: safe_join([ "For ", tag.strong(@user.email_address, class: "font-semibold text-normal"), ". You’ll be signed in once it’s saved." ]) %>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
  <%= render "components/errors", resource: @user %>

  <%# Lets password managers save the new password under the right account %>
  <%= tag.input type: "text", value: @user.email_address, autocomplete: "username", readonly: true, tabindex: -1, aria: { hidden: true }, class: "sr-only" %>

  <%= render "shared/new_password_fields", form:, label: "New Password", confirmation_label: "Confirm New Password" %>

  <%= form.submit "Save and Sign In", class: "btn btn-primary w-full" %>
<% end %>
