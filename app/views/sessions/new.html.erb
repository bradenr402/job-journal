<% content_for :title, "Sign In" %>
<% content_for :tagline, "Pick up where you left off. Your leads, notes, and interviews are just as you left them." %>

<div data-controller="email-handoff">
  <%= render "shared/auth_header", title: "Welcome back", subtitle: "Sign in to continue your job search." %>

  <%= form_with url: session_url, model: false, method: :post, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email Address", class: "form-label" %>
      <%= form.text_field :email_address, inputmode: "email", required: true, autofocus: params[:email_address].blank?, autocomplete: "username", autocapitalize: "none", spellcheck: false, value: params[:email_address], class: "form-input", data: { email_handoff_target: "email" } %>
    </div>

    <div>
      <%= render "shared/password_field", form:, attribute: :password, required: true, autofocus: params[:email_address].present?, autocomplete: "current-password",
            label_action: link_to("Forgot password?", new_password_path, class: "btn-link text-xs no-underline hover:underline", data: { action: "email-handoff#carry" }) %>
    </div>

    <%= form.submit "Sign In", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-8 text-sm text-soft text-center">
    New here? <%= link_to "Create an account", new_registrations_path, class: "btn-link btn-link-primary", data: { action: "email-handoff#carry" } %>
  </p>
</div>
