<% content_for :title, "Sign Up" %>
<% content_for :tagline do %>A job search is a lot to keep in your head. <em>Write it down.</em><% end %>
<% content_for :tagline_fact, "Free. No ads. We don’t sell your data." %>

<div data-controller="email-handoff">
  <%= render "shared/auth_header", title: "Create your account", subtitle: "Track every lead, interview, and offer in one private place." %>

  <%= form_with url: registrations_url, model: @user, method: :post, class: "space-y-5" do |form| %>
    <%= render "components/errors", resource: @user %>

    <div>
      <%= form.label :email_address, "Email Address", class: "form-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, value: params[:email_address].presence || @user.email_address, class: "form-input", data: { email_handoff_target: "email" } %>
    </div>

    <%= render "shared/new_password_fields", form: %>

    <%= form.submit "Create Account", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-8 text-sm text-soft text-center">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "btn-link btn-link-primary", data: { action: "email-handoff#carry" } %>
  </p>
</div>
