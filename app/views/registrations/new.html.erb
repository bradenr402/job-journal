<% content_for :title, "Sign Up" %>

<div class="card">
  <h1 class="subheading">Sign Up</h1>
  <p class="text-soft">Sign up to create your account and level up your job search.</p>

  <%= form_with url: registrations_url, model: @user, method: :post, class: "contents" do |form| %>
    <% if @user.errors.any? %>
      <div class="mt-5"><%= render "components/errors", resource: @user %></div>
    <% end %>
    <div class="my-5">
      <%= form.label :email_address, "Email Address", class: "form-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "Enter your email address", value: params[:email_address].presence || @user.email_address, class: "form-input" %>
    </div>

    <%= render "shared/new_password_fields", form:, placeholder: "Enter your password", confirmation_placeholder: "Repeat your password" %>

    <div class="flex w-full items-center justify-between gap-2">
      <%= form.submit "Sign Up", class: "grow btn btn-primary" %>
    </div>
  <% end %>

  <div class="flex flex-col items-center gap-2 mt-4">
    <%= link_to "Already have an account? Sign in", new_session_path, class: "btn-link btn-link-muted" %>
  </div>
</div>
