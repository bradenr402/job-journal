<%# locals: () %>

<%# A vertical list of filter dropdowns: above the items on small screens, a sticky sidebar from @3xl up. %>
<aside id="note-filters" class="filter-panel">
  <div class="filter-panel-content">
    <%= render "shared/clear_filters", filters: @filters, path: notes_path(state: "all") %>

    <%= render "shared/sort_options", filters: @filters %>

    <div class="filter-group">
      <%
        state_icons = {
          all: "layers",
          active: "check-circle",
          archived: "archive"
        }.stringify_keys
      %>

      <%= render "shared/filter_dropdown",
        filters: @filters,
        name: :state,
        icon_name: "status",
        off: "all",
        context: "notes-state",
        options: @filters.class.options_for(:state).without("all").map { |state|
          { value: state, icon: state_icons.fetch(state) }
        } %>
    </div>

    <div class="filter-group">
      <%
        type_icons = {
          JobLead: "briefcase",
          Interview: "interview"
        }.stringify_keys
      %>

      <%= render "shared/filter_dropdown",
        filters: @filters,
        name: :notable_type,
        label: "Type",
        icon_name: "question-circle",
        context: "notes-type",
        options: @filters.class.options_for(:notable_type).map { |type|
          { value: type, label: human(type).pluralize.titleize, icon: type_icons.fetch(type) }
        } %>
    </div>
  </div>
</aside>
