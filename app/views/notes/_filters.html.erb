<%# locals: () %>

<%# Two-column label/options grid on small screens; a vertical sidebar from @3xl up. %>
<aside id="note-filters" class="filter-panel">
  <div class="filter-panel-content">
    <% if @filters.any_active? %>
      <div class="col-span-2">
        <%= link_to notes_path(job_lead_state: "all"), class: "@3xl:w-full btn btn-sm btn-destructive btn-muted [view-transition-name:clear-filters-button]" do %>
          <%= icon "eraser-filled", class: "size-4 shrink-0" %>
          <span>Clear Filters</span>
        <% end %>
      </div>
    <% end %>

    <%= render "shared/sort_options", filters: @filters %>

    <div class="filter-group">
      <%= filter_row_label "State", icon_name: "status" %>

      <div class="filter-options">
        <% [
          { state: "all", icon: "layers" },
          { state: "active", icon: "check-circle" },
          { state: "archived", icon: "archive" }
        ].each do |option| %>
          <% state = option[:state] %>

          <%= filter_link(
            path: notes_path(@filters.toggle_params(:job_lead_state, state, off: "all")),
            value: state,
            icon_name: option[:icon],
            selected: @job_lead_state == state,
            context: "notes-filter"
          ) %>
        <% end %>
      </div>
    </div>

    <div class="filter-group">
      <%= filter_row_label "Type", icon_name: "question-circle" %>

      <div class="filter-options">
        <% [
          { type: "JobLead", icon: "briefcase" },
          { type: "Interview", icon: "interview", tag_class: "tag-interview" }
        ].each do |option| %>
          <% type = option[:type] %>

          <%= filter_link(
            path: notes_path(@filters.toggle_params(:notable_type, type)),
            value: type,
            label: human(type).pluralize.titleize,
            icon_name: option[:icon],
            selected: @notable_type == type,
            context: "notes-notable-filter",
            tag_class: option[:tag_class]
          ) %>
        <% end %>
      </div>
    </div>
  </div>
</aside>
