<%# locals: (filters:) %>

<div class="filter-group">
  <%# Plain flex row: a scroll container would clip the dropdown menu. %>
  <div class="flex items-center gap-1.5">
    <div class="relative flex-1 min-w-0" data-controller="dropdown" data-dropdown-hide-dropdown-class="dropdown-hidden" data-dropdown-show-dropdown-class="dropdown-show">
      <button
        type="button"
        class="[view-transition-name:sort-dropdown-trigger] dropdown-trigger-outline w-full"
        data-dropdown-target="trigger"
        data-action="mousedown->dropdown#toggle keydown->dropdown#handleKeydown"
        aria-label="Sort by"
      >
        <%= icon "arrow-up-down", class: "size-4.5 shrink-0 -ml-0.75" %>
        <span class="flex-1 min-w-0 truncate text-left"><%= filters.sort&.titlecase || "Sort" %></span>
        <%= icon "chevron-down", class: "size-4 @3xl:size-4.5 shrink-0 -mr-0.75 in-toggle-has-open-dropdown:rotate-180 transition-all duration-120" %>
      </button>

      <div class="[view-transition-name:sort-dropdown-menu] dropdown-menu dropdown-menu-bottom-right dropdown-hidden translate-y-0.75" data-dropdown-target="menu">
        <%= link_to url_for(filters.sort_params), class: "dropdown-option dropdown-option-secondary" do %>
          <%= icon "check", class: "size-5 shrink-0 #{"invisible" if filters.sort}" %>
          <span>Default</span>
        <% end %>

        <div class="dropdown-divider"></div>

        <% filters.class.sort_options.each_key do |name| %>
          <%= link_to url_for(filters.sort_params(name:)), class: "dropdown-option dropdown-option-secondary" do %>
            <%= icon "check", class: "size-5 shrink-0 #{"invisible" unless filters.sort == name}" %>
            <span><%= name.titlecase %></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if filters.sort %>
      <% is_descending = filters.sort_direction == "desc" %>

      <%
        direction       = is_descending ? "descending" : "ascending"
        other_direction = is_descending ? "ascending" : "descending"
      %>

      <%= link_to(
        url_for(filters.direction_toggle_params),
        class: "sort-direction-toggle",
        aria: { label: "Sorted #{direction}. Switch to #{other_direction}." }
      ) do %>
        <%= tag.span(
          icon("arrow-up", class: "size-3.5 shrink-0") + "Asc",
          class: [ "sort-direction-option", "sort-direction-selected": !is_descending ]
        ) %>
        <%= tag.span(
          icon("arrow-down", class: "size-3.5 shrink-0") + "Desc",
          class: [ "sort-direction-option", "sort-direction-selected": is_descending ]
        ) %>
      <% end %>
    <% end %>
  </div>
</div>
