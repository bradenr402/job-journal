<%# locals: (form:, attribute:, autocomplete:, label: nil, placeholder: nil, required: false, autofocus: false, data: {}) %>

<%= form.label attribute, label, class: "form-label" %>
<div class="relative" data-controller="password-visibility">
  <%= form.password_field attribute,
        autocomplete:,
        placeholder:,
        required:,
        autofocus:,
        maxlength: 72,
        class: "form-input pr-11",
        data: { password_visibility_target: "input", **data } %>

  <button type="button" class="form-password-toggle" aria-label="Show password" aria-pressed="false"
          data-password-visibility-target="button"
          data-action="password-visibility#toggle">
    <span data-password-visibility-target="showIcon"><%= icon "eye-open", class: "size-4.5 shrink-0" %></span>
    <span data-password-visibility-target="hideIcon" hidden><%= icon "eye-closed", class: "size-4.5 shrink-0" %></span>
  </button>
</div>
