<%# locals: (target:, text:, hidden: false) %>

<p class="form-requirement mt-1.5" data-password-requirements-target="<%= target %>" <%= "hidden" if hidden %>>
  <span data-met="false"><%= icon "x-mini", class: "size-3.5 shrink-0" %></span>
  <span data-met="true" hidden><%= icon "check-mini", class: "size-3.5 shrink-0" %></span>
  <span><%= text %></span>
</p>
