<%# locals: (filters:, path:) %>

<% if filters.any_active? %>
  <div class="col-span-2">
    <%= link_to(
      icon("eraser-filled", class: "size-4 shrink-0") + "Clear Filters",
      path,
      class: "@3xl:w-full btn btn-sm btn-destructive btn-muted [view-transition-name:clear-filters-button]",
    ) %>
  </div>
<% end %>
