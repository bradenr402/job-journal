<%# locals: (form:, label: "Password", confirmation_label: "Confirm Your Password", placeholder: nil, confirmation_placeholder: nil) %>

<div data-controller="password-requirements" data-password-requirements-min-length-value="<%= User::PASSWORD_MIN_LENGTH %>">
  <div class="my-5">
    <%= render "shared/password_field", form:, attribute: :password, label:, placeholder:, required: true, autocomplete: "new-password",
          data: { password_requirements_target: "password", action: "input->password-requirements#update" } %>
    <%= render "shared/password_requirement", target: "length", text: "At least #{User::PASSWORD_MIN_LENGTH} characters" %>
  </div>

  <div class="my-5">
    <%= render "shared/password_field", form:, attribute: :password_confirmation, label: confirmation_label, placeholder: confirmation_placeholder, required: true, autocomplete: "new-password",
          data: { password_requirements_target: "confirmation", action: "input->password-requirements#update" } %>
    <%= render "shared/password_requirement", target: "match", text: "Passwords match", hidden: true %>
  </div>
</div>
