<%# locals: (form:, label: "Password", confirmation_label: "Confirm Password") %>

<div class="space-y-5" data-controller="password-requirements" data-password-requirements-min-length-value="<%= User::PASSWORD_MIN_LENGTH %>">
  <div>
    <%= render "shared/password_field", form:, attribute: :password, label:, required: true, autocomplete: "new-password", passwordrules: "minlength: #{User::PASSWORD_MIN_LENGTH};",
          data: { password_requirements_target: "password", action: "input->password-requirements#update" } %>
    <%= render "shared/password_requirement", target: "length", text: "At least #{User::PASSWORD_MIN_LENGTH} characters" %>
  </div>

  <div>
    <%= render "shared/password_field", form:, attribute: :password_confirmation, label: confirmation_label, required: true, autocomplete: "new-password",
          data: { password_requirements_target: "confirmation", action: "input->password-requirements#update" } %>
    <%= render "shared/password_requirement", target: "match", text: "Passwords match", hidden: true %>
  </div>
</div>
