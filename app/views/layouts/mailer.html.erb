<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      <% { 500 => "Aspekta-500", 800 => "Aspekta-800" }.each do |weight, file| %>
        @font-face {
          font-family: 'Aspekta';
          font-weight: <%= weight %>;
          src: url('<%= root_url %>fonts/<%= file %>.woff2') format('woff2');
        }
      <% end %>

      h1, p, a {
        margin: 0;
        padding: 0;
        font: inherit;
        color: inherit;
        text-decoration: none;
      }

      a {
        cursor: pointer;
      }

      .email-wrapper {
        max-width: 560px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        font-family: 'Aspekta', ui-sans-serif, -apple-system, 'Segoe UI', sans-serif;
        background-color: #ffffff;
        color: #262626;
      }

      .email-wordmark {
        display: inline-block;
        margin-bottom: 2rem;
      }

      .email-wordmark img {
        width: 28px;
        height: 28px;
        vertical-align: middle;
      }

      .email-wordmark span {
        margin-left: 6px;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #262626;
        vertical-align: middle;
      }

      .email-heading {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0a0a0a;
        letter-spacing: -0.015em;
        line-height: 1.25;
        margin-bottom: 1rem;
      }

      .email-text {
        font-size: 1rem;
        line-height: 1.6;
        color: #404040;
        margin-bottom: 1.5rem;
      }

      .email-text strong {
        font-weight: 600;
        color: #0a0a0a;
      }

      .email-button {
        display: inline-block;
        padding: 0.5rem 1rem;
        background-color: #00bc7d;
        color: #ffffff;
        font-size: 0.875rem;
        line-height: 1.25rem;
        font-weight: 500;
        border-radius: 0.5rem;
        text-decoration: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
      }

      .email-fallback {
        margin-top: 1rem;
        font-size: 0.8125rem;
        line-height: 1.5;
        color: #737373;
        word-break: break-all;
      }

      .email-fallback a {
        color: #009966;
        text-decoration: underline;
      }

      .email-note {
        margin-top: 2rem;
        font-size: 0.9375rem;
        line-height: 1.6;
        color: #404040;
      }

      .email-footer {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid #e5e5e5;
        font-size: 0.8125rem;
        line-height: 1.5;
        color: #a3a3a3;
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <a href="<%= root_url %>" class="email-wordmark"><img src="<%= root_url %>icon.png" alt=""><span>JobJournal</span></a>

      <%= yield %>

      <p class="email-footer">
        You’re getting this because it’s about your JobJournal account. We never send marketing email.
      </p>
    </div>
  </body>
</html>
