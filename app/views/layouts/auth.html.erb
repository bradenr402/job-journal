<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="bg-white dark:bg-neutral-950">
    <div class="min-h-svh grid grid-cols-1 lg:grid-cols-[24rem_1fr] xl:grid-cols-[28rem_1fr]">
      <aside class="max-lg:hidden flex flex-col justify-between gap-12 p-10 bg-neutral-50 dark:bg-neutral-925 border-r border-neutral-200 dark:border-neutral-800 [view-transition-name:auth-aside]">
        <%= render "layouts/auth_wordmark" %>

        <p class="max-w-xs text-sm/6 text-light text-pretty"><%= yield :tagline %></p>
      </aside>

      <main class="flex flex-col px-6 py-10 sm:py-16">
        <div class="lg:hidden flex justify-center mb-12">
          <%= render "layouts/auth_wordmark" %>
        </div>

        <div class="w-full max-w-sm mx-auto lg:my-auto">
          <%= render "components/flash", inline: true %>

          <%= yield %>
        </div>

        <p class="lg:hidden mt-auto pt-12 max-w-xs mx-auto text-sm text-soft text-center text-pretty"><%= yield :tagline %></p>
      </main>
    </div>
  </body>
</html>
