<%
  flash_styles = {
    success: { icon: "check-circle-filled", color: "text-primary-500", timeout: 6000 },
    notice: { icon: "check-circle-filled", color: "text-blue-500", timeout: 6000 },
    error: { icon: "x-circle-filled", color: "text-rose-500", timeout: 10000 },
    alert: { icon: "alert-triangle-filled", color: "text-yellow-500", timeout: 10000 }
  }.stringify_keys
%>

<% if flash.any? %>
  <div class="flash-region" data-turbo-temporary>
    <% flash.each do |key, message| %>
      <% style = flash_styles.fetch(key, flash_styles["notice"]) %>
      <%= tag.div(
        id: key,
        class: "flash",
        role: (%w[error alert].include?(key) ? "alert" : "status"),
        style: "view-transition-name: flash-#{key}",
        data: {
          controller: "flash",
          flash_timeout_value: style[:timeout],
          action: "mouseenter->flash#pause mouseleave->flash#resume focusin->flash#pause focusout->flash#resume"
        }
      ) do %>
        <%= icon style[:icon], class: [ "size-5 shrink-0", style[:color] ] %>
        <p class="flex-1 text-pretty"><%= message.html_safe %></p>
        <button type="button" class="flash-close" data-action="flash#dismiss">
          <span class="sr-only">Dismiss</span>
          <%= icon "x", class: "size-4" %>
        </button>
      <% end %>
    <% end %>
  </div>
<% end %>
