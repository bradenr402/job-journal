<%# locals: (inline: false) %>

<%
  flash_classes = {
    success: "flash-success",
    error: "flash-error",
    notice: "flash-notice",
    alert: "flash-alert"
  }.stringify_keys
%>

<% flash.each do |key, message| %>
  <%=
    tag.p(
      message.html_safe,
      class: [
        inline ? "mb-6 py-3 px-4 rounded-lg font-medium text-sm text-pretty" : "flash",
        flash_classes[key],
        ("md:rounded-t-xl" unless inline),
      ],
      style: "view-transition-name: flash-#{key}",
      id: key
    )
  %>
<% end %>

<% if success || error || notice || alert %>
  <script>
    setTimeout(() => {
      const flashes = [
        { id: 'success', timeout: 6000 },
        { id: 'notice', timeout: 6000 },
        { id: 'error', timeout: 10000 },
        { id: 'alert', timeout: 10000 }
      ]

      flashes.forEach(flash => {
        const el = document.getElementById(flash.id)
        if (el) setTimeout(() => el.remove(), flash.timeout)
      })
    }, 0)
  </script>
<% end %>
