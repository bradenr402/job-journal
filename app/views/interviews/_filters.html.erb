<%# locals: () %>

<%# A vertical list of filter dropdowns: above the items on small screens, a sticky sidebar from @3xl up. %>
<aside id="interview-filters" class="filter-panel">
  <div class="filter-panel-content">
    <%= render "shared/clear_filters", filters: @filters, path: interviews_path(timeframe: "all") %>

    <%= render "shared/sort_options", filters: @filters %>

    <div class="filter-group">
      <%
        timeframe_icons = {
          all: "layers",
          upcoming: "time-schedule",
          completed: "check-circle"
        }.stringify_keys
      %>

      <%= render "shared/filter_dropdown",
        filters: @filters,
        name: :timeframe,
        icon_name: "date-time",
        off: "all",
        context: "interviews-timeframe",
        options: @filters.class.options_for(:timeframe).without("all").map { |timeframe| { value: timeframe, icon: timeframe_icons[timeframe] } }
      %>
    </div>

    <div class="filter-group">
      <%= render "shared/rating_dropdown", filters: @filters, context: "interviews-rating" %>
    </div>
  </div>
</aside>
