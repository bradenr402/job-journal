<% content_for :title, 'JobJournal • Personal Job Search Tracker' %>

<%# ─── NAV ─── %>
<nav class="floating-nav fixed top-0 inset-x-0 z-50">
  <div class="floating-nav-bar max-w-8xl max-md:mx-4 md:mx-auto py-3 pl-4.5 pr-3 flex items-center justify-between backdrop-blur-sm">
    <%= link_to root_path, class: 'focus-visible:ring-2 focus-visible:ring-primary-500 outline-none p-2 -m-2 rounded-lg flex items-center max-md:gap-0.75 md:gap-1.5' do %>
      <%= icon 'note-filled', class: 'max-md:size-4.5 md:size-6 shrink-0 text-primary-500' %>
      <span class="max-md:text-base md:text-xl font-extrabold tracking-tight text-normal">JobJournal</span>
    <% end %>

    <div class="flex items-center gap-3">
      <% if authenticated? %>
        <%= link_to dashboard_path, data: { turbo: false }, class: 'btn btn-transparent btn-muted' do %>
          <span>Dashboard</span>
          <%= icon 'arrow-right', class: 'size-4.75 shrink-0' %>
        <% end %>
      <% else %>
        <%= link_to 'Sign In', new_session_path, data: { turbo: false }, class: 'btn btn-transparent' %>
        <%= link_to 'Sign Up Free', new_registrations_path, data: { turbo: false }, class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
</nav>

<main class="landing-section-dividers">
  <%# ─── HERO ─── %>
  <section class="pt-36 md:pt-44 pb-24 md:pb-32 px-6 *:max-w-8xl *:mx-auto">
    <div class="text-center">
      <h1 class="text-[clamp(2.6rem,8vw,6rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 leading-[1.08] text-balance">
        <% hero_title = "Your Job Search. <br> Your Terms." %>

        <span class="sr-only"><%= hero_title %></span>
        <span aria-hidden="true">
          <% hero_title.split.each.with_index do |word, index| %>
            <% if word == "<br>" %>
              <br>
            <% else %>
              <span class="hero-title-word" style="--hero-stagger-index: <%= index %>;"><%= word %></span>
            <% end %>
          <% end %>
        </span>
      </h1>

      <p class="hero-stagger-item [--enter-delay:520] mt-5 text-[clamp(1rem,1.65vw,1.25rem)] text-light max-w-2xl mx-auto text-balance leading-relaxed">
        Organize every lead, application, and interview in&nbsp;one&nbsp;place.
        No messy spreadsheets.&nbsp;No data selling.&nbsp;No recruiter dashboards.
      </p>

      <div class="hero-stagger-item [--enter-delay:640] mt-10 flex items-center justify-center">
        <%= link_to "#demo", data: { turbo: false }, class: 'btn btn-lg btn-primary' do %>
          <span>See How it Works</span>
          <%= icon 'arrow-right', class: 'size-5 shrink-0' %>
        <% end %>
      </div>
      <p class="hero-stagger-item [--enter-delay:760] text-sm text-soft mt-4">Free forever. No credit card required.</p>
    </div>

    <%# ── Hero screenshot ── %>
    <div class="hero-stagger-item [--enter-delay:880] max-md:-mx-4 mt-20 md:mt-28 rounded-[clamp(0.5rem,1vw,1.1rem)] ring-1 ring-neutral-200/60 dark:ring-neutral-800/30 not-dark:shadow-xl overflow-hidden">
      <div class="max-md:hidden">
        <%= image_tag 'dashboard.webp', alt: 'JobJournal dashboard showing weekly stats, upcoming interviews, and follow-up suggestions', class: 'dark:hidden w-full h-auto', loading: 'eager' %>
        <%= image_tag 'dashboard-dark.webp', alt: '', aria: { hidden: true }, class: 'not-dark:hidden w-full h-auto', loading: 'eager' %>
      </div>
      <div class="md:hidden">
        <%= image_tag 'dashboard-small.webp', alt: '', aria: { hidden: true }, class: 'dark:hidden w-full h-auto', loading: 'eager' %>
        <%= image_tag 'dashboard-small-dark.webp', alt: '', aria: { hidden: true }, class: 'not-dark:hidden w-full h-auto', loading: 'eager' %>
      </div>
    </div>
  </section>

  <%# ─── PROBLEM & SOLUTION ─── %>
  <section class="py-28 md:py-36 px-6">
    <div
      class="
        max-w-8xl mx-auto grid grid-cols-1 lg:grid-cols-2
        max-lg:divide-y lg:divide-x divide-neutral-200 dark:divide-neutral-800
        *:w-full *:max-lg:max-w-3xl *:max-lg:mx-auto
        *:first:lg:pr-12 *:first:max-lg:pb-14
        *:last:lg:pl-12 *:last:max-lg:pt-12
      "
    >
      <%# ── Problem ── %>
      <div>
        <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-tight">
          Spreadsheets weren’t built&nbsp;for&nbsp;this.
        </h2>

        <div class="mt-8 space-y-5 text-light text-pretty">
          <p class="leading-relaxed">
            When you’re juggling multiple applications, deadlines, and interviews, everyone seems to preach the same gospel: <%= quote "just open Excel or Google Sheets and log every lead." %> It works&mdash;until it doesn’t.
          </p>

          <ul class="space-y-2 list-none">
            <% [
              "Spreadsheets don’t remind you to follow up, flag stale leads, or tell you which sources are working.",
              "Notes, meeting links, and interview prep end up scattered across apps where they’re too easily forgotten.",
              "The more applications you add, the harder they are to maintain&mdash;and the less useful they become."
            ].each do |text| %>
              <li class="flex gap-3 items-start">
                <span class="mt-2.5 size-1.5 rounded-full bg-primary-500 shrink-0"></span>
                <span><%= text.html_safe %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <%# ── Solution ── %>
      <div>
        <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-primary-550 dark:text-primary-500 text-balance leading-tight">
          JobJournal flips that&nbsp;script.
        </h2>

        <div class="mt-8 space-y-5 text-light leading-relaxed text-pretty">
          <p>
            Instead of babysitting cells, every opportunity becomes a <span class="text-normal font-semibold">living record</span>. Follow-up suggestions and stale job lead alerts surface on your dashboard automatically. Notes stay attached to the stage they belong to. Insights show which sources actually convert. And universal search finds anything instantly.
          </p>

          <p>
            <span class="text-neutral-900 dark:text-neutral-100 font-semibold">Focus on your workflow, not managing rows.</span>
            JobJournal scales from a single dream role to 100 concurrent applications&mdash;without breaking your flow or compromising your privacy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <%# ─── DEMO: DASHBOARD STATS ─── %>
  <section id="demo" class="py-28 md:py-36 px-6">
    <div class="max-w-8xl mx-auto">
      <p class="text-center text-sm font-semibold uppercase tracking-[-0.015em] text-primary-550 dark:text-primary-500 mb-3">Your dashboard at a glance</p>
      <h2 class="text-center text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-tight mb-12">
        See where you stand&mdash;instantly.
      </h2>

      <div
        class="
          [--demo-padding:--spacing(1)]
          [--demo-inner-radius:var(--radius-2xl)]
          [--demo-outer-radius:calc(var(--demo-inner-radius)+var(--demo-padding))]
          p-(--demo-padding)! rounded-(--demo-outer-radius)
          card max-md:hidden not-dark:shadow-lg overflow-hidden relative
          [--demo-border-width:1px]
        "
      >
        <span class="select-none font-semibold uppercase tracking-[-0.015em] text-light mt-2 mb-3 absolute top-3 left-1/2 -translate-x-1/2 z-10 bg-white dark:bg-neutral-950 border-(length:--demo-border-width) border-neutral-200/60 dark:border-neutral-800/60 px-4 py-2 rounded-[0.65rem] shadow-lg">Dashboard demo</span>

        <div class="relative rounded-(--demo-inner-radius) border-(length:--demo-border-width) border-neutral-300 dark:border-neutral-800 overflow-hidden">
          <iframe src="<%= asset_path "JobJournal-demo.html" %>" id="JobJournal-demo" class="w-full aspect-3/2"></iframe>

          <div class="pointer-events-none absolute inset-0 shadow-[inset_0_0_8px_rgba(0,0,0,0.2)] rounded-[calc(var(--demo-inner-radius)-var(--demo-border-width))]"></div>
        </div>
      </div>

      <div class="card-list md:hidden max-w-5xl mx-auto mt-20">
        <div class="relative card flex flex-col">
          <div class="flex items-start justify-between mb-5">
            <p class="font-semibold">Job Leads This Week</p>
            <%= icon 'briefcase', class: 'size-5 shrink-0' %>
          </div>
          <div class="mt-auto">
            <p class="font-extrabold text-4xl mb-1"><%= @demo.job_lead_stats[:count] %></p>
            <p class="text-xs text-muted"><%= @demo.job_lead_stats[:change] %></p>
          </div>
        </div>

        <div class="relative card flex flex-col">
          <div class="flex items-start justify-between mb-5">
            <p class="font-semibold">Applications This Week</p>
            <%= icon 'application', class: 'size-5 shrink-0' %>
          </div>
          <div class="mt-auto flex items-end justify-between">
            <div>
              <p class="font-extrabold text-4xl mb-1">
                <%= applications_count = @demo.application_stats[:count] %>
                <span class="text-sm font-normal text-muted">/ <%= applications_goal = @demo.application_stats[:goal] %></span>
              </p>
              <p class="text-xs text-muted"><%= @demo.application_stats[:change] %></p>
            </div>
            <% percent = applications_count.to_f / applications_goal.to_f * 100 %>
            <%= render 'shared/progress_dial', percent: percent %>
          </div>
        </div>

        <div class="relative card flex flex-col">
          <div class="flex items-start justify-between mb-5">
            <p class="font-semibold">Interviews This Week</p>
            <%= icon 'interview', class: 'size-5 shrink-0' %>
          </div>
          <div class="mt-auto flex items-end justify-between">
            <div>
              <p class="font-extrabold text-4xl mb-1"><%= @demo.interview_stats[:count] %></p>
              <p class="text-xs text-muted"><%= @demo.interview_stats[:change] %></p>
            </div>
            <% average_rating = @demo.interview_stats[:average_rating] %>
            <div class="flex flex-col items-end">
              <p class="text-muted text-xs flex items-center gap-1">Average Rating</p>
              <div class="font-bold flex items-center gap-x-1">
                <% 1.upto(5) do |star| %>
                  <%= icon 'star', class: "size-5 transition-all duration-120 #{average_rating >= star ? 'text-yellow-400 fill-yellow-400' : 'fill-transparent text-muted'}" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ─── DEMO: JOB LEADS & INTERVIEWS ─── %>
  <section class="py-28 md:py-36 px-6">
    <div class="max-w-8xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-[-0.015em] text-primary-550 dark:text-primary-500 mb-3">Track every opportunity</p>
      <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-tight mb-4">
        From first lead to final&nbsp;offer.
      </h2>
      <p class="text-light max-w-2xl text-pretty leading-relaxed mb-12">
        Status. Tags. Notes. A complete timeline. One opportunity, one place, nothing lost. Interviews and notes stay anchored to where they belong, not buried in separate tabs.
      </p>

      <div aria-hidden="true">
        <%# ── Job Lead Cards ── %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-12">
          <% @demo.leads.each do |lead| %>
            <%= render lead %>
          <% end %>
        </div>

        <%# ── Interview Cards ── %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% @demo.interviews.each do |interview| %>
            <%= render interview %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%# ─── WHY JOBJOURNAL ─── %>
  <section class="py-28 md:py-36 px-6">
    <% conditional_break = '<br class="max-lg:hidden"/>' %>
    <% @features = [
      {
        title: "Built for you.#{conditional_break} Not for companies.".html_safe,
        body: 'Recruiter tools serve companies. Job boards serve advertisers. JobJournal serves <strong class="text-normal font-semibold">you</strong>&mdash;keeping you in control of your job search and your data.'.html_safe,
      },
      {
        title: "100% Free.#{conditional_break} Forever.",
        body: "JobJournal is <strong class='text-normal font-semibold'>free forever</strong>&mdash;because a tool for your job search shouldn’t profit from your job search. No trials, no paywalls, no #{quote 'upgrade to unlock'}, no subscriptions, and no hidden fees.".html_safe,
      },
      {
        title: 'Your Data is Truly Yours.'.html_safe,
        body: 'JobJournal is <strong class="text-normal font-semibold">privacy-first</strong> by design&mdash;no third-party sharing, no data selling, no recruiter analytics. Your data stays scoped to your account, you can <strong class="text-normal font-semibold">export it all as JSON or CSV</strong> whenever you like, and you can delete it all at any time.'.html_safe,
      }
    ] %>

    <div
      class="
        max-w-8xl mx-auto grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3
        gap-12 lg:gap-y-24 max-lg:divide-y
        lg:*:first:pr-12 max-lg:*:first:pb-12
        lg:*:first:border-r *:first:border-neutral-200 dark:*:first:border-neutral-800
        2xl:*:nth-2:pr-12 max-lg:*:nth-2:pb-12
        2xl:*:nth-2:border-r *:nth-2:border-neutral-200 dark:*:nth-2:border-neutral-800
      "
    >
      <% @features.each.with_index(1) do |feature, index| %>
        <div class="<%= 'lg:max-2xl:col-span-2 lg:max-2xl:mx-auto lg:max-2xl:max-w-2xl' if index == 3 %>">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight leading-tight text-balance">
            <%= raw feature[:title] %>
          </h2>

          <p class="mt-6 text-light leading-relaxed text-pretty max-w-[75ch]">
            <%= raw feature[:body] %>
          </p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ─── DEMO: NOTES ─── %>
  <section class="py-28 md:py-36 px-6">
    <div class="max-w-8xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-24">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-tight">
            Everything exactly where it should be.
          </h2>
          <p class="mt-4 text-[clamp(1rem,1.2vw,1.125rem)] text-light leading-relaxed text-pretty">
            Attach notes directly to job leads and interviews. Prep for interviews, jot down reflection notes, and track offer details without ever losing context.
          </p>
        </div>

        <div aria-hidden="true" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% @demo.notes.each_with_index do |note, index| %>
            <div class="<%= 'max-md:hidden' if index >= 3 %>">
              <%= render note %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%# ─── FEATURE SHOWCASE: ALERTS & REMINDERS ─── %>
  <section class="py-28 md:py-36 px-6">
    <div class="max-w-8xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-24">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-tight">
            Nothing falls through the cracks.
          </h2>
          <p class="mt-4 text-[clamp(1rem,1.2vw,1.125rem)] text-light leading-relaxed text-pretty">
            Upcoming interviews surface automatically. Stale leads you forgot to apply to are flagged for you. After every application and interview, a nudge to follow up appears.
          </p>
        </div>

        <div class="space-y-8" aria-hidden="true">
          <%# Follow-up suggestions %>
          <div class="@container">
            <div class="mb-4">
              <h2 class="subheading">Follow-Up Suggestions</h2>
              <p class="text-sm text-muted mt-1 text-pretty">
                <%
                  suggest_demo_days = 3
                  demo_days = { application: 7, interview: 2 }
                  stop_follow_up = demo_days.transform_values { |days| days + suggest_demo_days }
                %>
                Active job leads not updated in <%= demo_days[:application] %>&ndash;<%= stop_follow_up[:application] %> days since applying or <%= demo_days[:interview] %>&ndash;<%= stop_follow_up[:interview] %> days since interviewing.
              </p>
            </div>

            <div class="card">
              <div class="grid grid-cols-1 @xl:grid-cols-2 gap-1.5">
                <% @demo.suggestions.each do |suggestion| %>
                  <div class="relative flex flex-col gap-5 bg-neutral-100 dark:bg-neutral-800/60 p-3 rounded-md">
                    <div class="flex items-center gap-2.5">
                      <div class="flex flex-col">
                        <div class="text-lg font-semibold leading-snug mb-1">
                          <span><%= suggestion[:title] %></span>
                          <span class="font-normal ml-0.5 tag tag-<%= suggestion[:status] %>">
                            <%= suggestion[:status].titlecase %>: <span class="text-xs opacity-65"><%= local_date_short suggestion[:status_at] %></span>
                          </span>
                        </div>

                        <div class="flex items-center gap-1 text-sm text-soft">
                          <%= icon 'company', class: 'size-3.75 shrink-0' %>
                          <%= suggestion[:company] %>
                        </div>
                      </div>
                    </div>

                    <p class="text-xs text-muted">
                      <%
                        action = suggestion[:status] == 'applied' ? 'applied to' : 'interviewed for'
                        time   = suggestion[:status_at]
                      %>
                      You <%= action %> this job <span class="font-semibold text-soft"><%= time_ago_in_words time %> ago</span>.
                      Consider sending a follow-up email, or archive it if you&#8217;re no longer interested.
                    </p>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <%# Stale lead %>
          <div>
            <div class="mb-4">
              <h2 class="subheading">Stale Job Leads</h2>
              <p class="text-sm text-muted mt-1 text-pretty">Job leads saved more than 7 days ago that you haven&#8217;t applied to yet. Apply now, or archive if you&#8217;re no longer interested.</p>
            </div>
            <div id="job_leads" class="@container">
              <div class="grid grid-cols-1 @xl:grid-cols-2 <%= '@4xl:grid-cols-3' if @demo.stale_leads.size >= 3 && @demo.stale_leads.size != 4 %> gap-3">
                <% @demo.stale_leads.each do |job_lead| %>
                  <%= render 'job_leads/job_lead', job_lead: job_lead %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ─── FEATURE SHOWCASE: INSIGHTS ─── %>
  <section class="py-28 md:py-36 px-6">
    <div class="max-w-8xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-24">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-tight">
            See what&#8217;s actually working.
          </h2>
          <p class="mt-4 text-[clamp(1rem,1.2vw,1.125rem)] text-light leading-relaxed text-pretty">
            Track leads, applications, and interviews week over week. Set a weekly application goal and watch your progress. See which sources produce interviews and offers&mdash;and which are wasting your time.
          </p>
        </div>

        <div class="@container space-y-3" aria-hidden="true">
          <%# Top Sources %>
          <div class="card">
            <div class="mb-5">
              <div class="flex items-start justify-between">
                <p class="font-semibold">Top Sources</p>
                <%= icon 'globe', class: 'size-5 shrink-0' %>
              </div>
              <p class="text-xs text-muted">See where your best job leads are coming from.</p>
            </div>

            <%= render "shared/sources", sources: @demo.sources %>
          </div>

          <%# Top Tags %>
          <div class="card">
            <div class="mb-5">
              <div class="flex items-start justify-between">
                <p class="font-semibold">Top Tags</p>
                <%= icon 'tag', class: 'size-5 shrink-0' %>
              </div>
              <p class="text-xs text-muted">Up to 20 of your most frequently used tags across your job leads.</p>
            </div>

            <div class="flex flex-wrap items-center gap-1 mb-4">
              <% @demo.top_tags.each do |tag| %>
                <span class="tag tag-filter demo"><%= tag %></span>
              <% end %>
            </div>

            <p class="text-xs text-muted">
              Filter by tags to find your job leads fast.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ─── IMPORT & EXPORT ─── %>
  <section class="py-28 md:py-36 px-6">
    <div class="max-w-8xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-tight">
            Bring your spreadsheet. Take&nbsp;everything with&nbsp;you.
          </h2>
          <p class="mt-4 text-[clamp(1rem,1.2vw,1.125rem)] text-light leading-relaxed text-pretty">
            Import your job search from a CSV: match your columns, review every row, and choose what happens to leads you already have. Export everything as JSON or CSV whenever you like. No lock-in, ever.
          </p>
        </div>

        <div aria-hidden="true" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="card flex flex-col">
            <div class="flex items-start justify-between mb-4">
              <h3 class="font-semibold text-normal">Import From CSV</h3>
              <div class="rounded-md p-1.5 -m-0.75 bg-teal-100/70 dark:bg-teal-900/40 inline-flex">
                <%= icon "file-import", class: "size-4.5 text-teal-600 dark:text-teal-500" %>
              </div>
            </div>
            <ul class="grid grid-cols-[auto_1fr_auto] gap-x-3 divide-y divide-neutral-200 dark:divide-neutral-800 text-sm">
              <% [ [ "Position", "Job Title", "briefcase" ], [ "Employer", "Company", "company" ], [ "Link", "Application URL", "link" ], [ "Date Applied", "Applied", "application" ] ].each do |header, field, field_icon| %>
                <li class="col-span-3 grid grid-cols-subgrid items-center py-2">
                  <span class="text-muted truncate"><%= header %></span>
                  <%= icon "arrow-right", class: "size-3.5 shrink-0 text-muted justify-self-center" %>
                  <span class="flex items-center gap-1.5 min-w-0 font-medium text-light">
                    <%= icon field_icon, class: "size-4 shrink-0 text-muted" %>
                    <span class="truncate"><%= field %></span>
                  </span>
                </li>
              <% end %>
            </ul>
            <p class="mt-auto pt-3 text-xs text-muted">Match columns with one click. Review every row before anything is saved.</p>
          </div>

          <div class="card flex flex-col">
            <div class="flex items-start justify-between mb-4">
              <h3 class="font-semibold text-normal">Export Anytime</h3>
              <div class="rounded-md p-1.5 -m-0.75 bg-rose-100/70 dark:bg-rose-900/40 inline-flex">
                <%= icon "file-export", class: "size-4.5 text-rose-600 dark:text-rose-500" %>
              </div>
            </div>
            <ul class="divide-y divide-neutral-200 dark:divide-neutral-800 text-sm">
              <% [ [ "jobjournal-export.json", "braces" ], [ "job-leads.csv", "csv" ], [ "interviews.csv", "csv" ], [ "notes.csv", "csv" ] ].each do |file, file_icon| %>
                <li class="flex items-center gap-1.5 min-w-0 py-2 font-medium text-light">
                  <%= icon file_icon, class: "size-4 shrink-0 text-muted" %>
                  <span class="truncate"><%= file %></span>
                </li>
              <% end %>
            </ul>
            <p class="mt-auto pt-3 text-xs text-muted">Your data is yours&mdash;download a full copy whenever you like.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ─── MORE FEATURES ─── %>
  <%= render "pages/landing/more_features" %>

  <%# ─── FINAL CTA ─── %>
  <section class="py-32 md:py-40 px-6 ruled-backdrop bg-ruled-plain [--ruled-mask:radial-gradient(closest-side,black_30%,transparent)]">
    <%# Every box is a multiple of the 2rem rules so the text sits on them %>
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 text-balance leading-16 relative top-[calc(22.33px_-_0.333em)]">
        Ready to ditch the&nbsp;spreadsheet?
      </h2>

      <p class="mt-8 text-[clamp(1rem,1.2vw,1.125rem)] text-light leading-8">
      Stay organized, stay motivated, and stay private&NoBreak;&mdash;&NoBreak;free forever.
      </p>

      <%# Puts the button's center on a rule %>
      <div class="mt-[33px] flex flex-wrap items-center justify-center gap-4">
        <%= link_to authenticated? ? dashboard_path : new_registrations_path, data: { turbo: false }, class: 'btn btn-lg btn-primary' do %>
          <span>Take Control of Your Search</span>
          <%= icon 'arrow-right', class: 'size-5 shrink-0' %>
        <% end %>
      </div>
    </div>
  </section>
</main>

<%# ─── FOOTER ─── %>
<footer class="p-4">
  <div
    class="
      footer-reveal group/footer max-w-8xl md:mx-auto
      rounded-4xl ring-1 ring-neutral-200/60 dark:ring-neutral-800/60
      [--footer-padding:--spacing(8)] md:[--footer-padding:--spacing(12)] p-(--footer-padding)
      [--footer-gap:--spacing(8)] md:[--footer-gap:--spacing(16)]

      bg-neutral-50 dark:bg-neutral-900/40
    "
  >
    <%# ── Top grid ── %>
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto] gap-(--footer-gap)">
      <%# Brand %>
      <div class="space-y-4">
        <div class="flex items-center gap-1.5 text-primary-500">
          <%= icon 'note-filled', class: 'size-7 shrink-0' %>
          <span class="text-2xl font-extrabold tracking-tight text-neutral-900 dark:text-white">JobJournal</span>
        </div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-xs text-pretty">
          A privacy-first job search tracker. Organize every lead, application, and interview in one place.
        </p>
      </div>

      <%# Resources %>
      <div class="space-y-2 md:text-right">
        <p class="text-xs uppercase tracking-[-0.015em] font-semibold text-muted dark:text-soft">Resources</p>
        <ul>
          <li>
            <%= link_to 'https://github.com/bradenr402/job-journal', target: '_blank', rel: 'noopener noreferrer', class: 'inline-flex items-center gap-1 text-base font-semibold text-neutral-700 hover:text-primary-550 dark:text-neutral-200 dark:hover:text-primary-400 transition-colors duration-80' do %>
              <%= icon 'github', class: 'size-4 shrink-0' %>
              <span>GitHub</span>
            <% end %>
          </li>
        </ul>
      </div>

      <%# Contact %>
      <div class="space-y-2 md:text-right">
        <p class="text-xs uppercase tracking-[-0.015em] font-semibold text-muted dark:text-soft">Contact</p>
        <ul>
          <li>
            <%= mail_to 'jobjournalapp@gmail.com', class: 'inline-flex items-center gap-1 text-base font-semibold tracking-tight text-neutral-900 hover:text-primary-550 dark:text-white dark:hover:text-primary-400 transition-colors duration-80' do %>
              <%= icon 'mail', class: 'size-4 shrink-0' %>
              <span>jobjournalapp@gmail.com</span>
            <% end %>
          </li>
        </ul>
      </div>
    </div>

    <%# ── Bottom row ── %>
    <div class="mt-[calc(var(--footer-padding)*2)] pt-(--footer-padding) border-t border-neutral-200 dark:border-neutral-800 flex flex-wrap gap-2 items-center justify-between text-xs text-neutral-600 dark:text-neutral-500">
      <p>&copy; <%= Date.current.year %> JobJournal. All Rights Reserved.</p>
      <p>
        Created with
        <%= icon 'heart-filled', class: 'inline align-middle size-3.75 mx-px mb-px motion-safe:animate-heartbeat text-rose-500' %>
        by <%= link_to 'Braden Roth', 'https://bradenroth.com', target: '_blank', rel: 'noopener noreferrer', class: 'text-normal hover:text-primary-550 dark:hover:text-primary-500 transition-colors duration-80' %>
      </p>
    </div>
  </div>
</footer>
