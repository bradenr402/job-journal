<%# The search card from the Search page, with a query being typed %>
<div class="card card-sm rounded-2xl text-left">
  <div class="relative">
    <span class="form-input-transparent -my-2 pl-7 pr-9 text-light">
      stripe<span class="inline-block align-[-3px] ml-px h-4 w-px bg-primary-500 bento-while-hover-[bento-caret_1s_steps(1)_infinite]"></span>
    </span>
    <%= icon "search", class: "size-5 shrink-0 absolute left-0 top-1/2 -translate-y-1/2 text-light" %>
    <span class="form-search-clear right-0">
      <%= icon "x", class: "form-search-clear-icon" %>
    </span>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    <span class="dropdown-trigger-outline">
      <%= icon "briefcase-filled", class: "size-3.75 shrink-0 -ml-0.75" %>
      <span class="max-w-40 truncate">Job Leads</span>
      <%= icon "chevron-down", class: "size-4 shrink-0 -mr-0.75" %>
    </span>
    <span class="dropdown-trigger-outline">
      <%= icon "timeline", class: "size-4.5 shrink-0 -ml-0.75" %>
      <span class="max-w-40 truncate">Status</span>
      <%= icon "chevron-down", class: "size-4 shrink-0 -mr-0.75" %>
    </span>
  </div>
</div>
