<%# locals: () %>

<%
  scope_icons = {
    all: "layers",
    job_leads: "briefcase",
    interviews: "interview",
    notes: "quill"
  }.stringify_keys

  timeframe_icons = {
    upcoming: "time-schedule",
    completed: "check-circle"
  }.stringify_keys

  notable_type_icons = {
    JobLead: "briefcase",
    Interview: "interview"
  }.stringify_keys

  search_params = { q: @query, scope: @search_scope }.compact_blank

  filters_active =
    @search_scope != "all" ||
    @job_lead_filters.filtered?(:status) ||
    @interview_filters.filtered?(:timeframe) ||
    @interview_filters.filtered?(:rating) ||
    @note_filters.filtered?(:notable_type)
%>

<%# Inline row of filter dropdowns. The dropdowns navigate via links, so
    hidden fields carry their state through the form's auto-submit. %>
<div id="search-filters" class="mt-3 flex flex-wrap items-center gap-1.5">
  <%= hidden_field_tag :scope, @search_scope unless @search_scope == "all" %>
  <%= hidden_field_tag :status, @job_lead_filters.status if @job_lead_filters.filtered?(:status) %>
  <%= hidden_field_tag :timeframe, @interview_filters.timeframe if @interview_filters.filtered?(:timeframe) %>
  <%= hidden_field_tag :rating, @interview_filters.rating if @interview_filters.filtered?(:rating) %>
  <%= hidden_field_tag :notable_type, @note_filters.notable_type if @note_filters.filtered?(:notable_type) %>

  <% if filters_active %>
    <%= link_to(
      icon("eraser-filled", class: "size-4 shrink-0") + "Clear",
      search_path(q: @query),
      class: "btn btn-sm btn-destructive btn-muted [view-transition-name:search-clear-filters]",
      aria: { label: "Clear filters" }
    ) %>
  <% end %>

  <div class="relative" data-controller="dropdown" data-dropdown-hide-dropdown-class="dropdown-hidden" data-dropdown-show-dropdown-class="dropdown-show">
    <button
      type="button"
      class="[view-transition-name:search-scope-dropdown-trigger] dropdown-trigger-outline"
      data-dropdown-target="trigger"
      data-action="mousedown->dropdown#toggle keydown->dropdown#handleKeydown"
      aria-label="Search in"
    >
      <%= icon "#{scope_icons[@search_scope]}-filled", class: "size-3.75 @3xl:size-4.5 shrink-0 -ml-0.75" %>
      <span class="max-w-40 truncate"><%= @search_scope.titlecase %></span>
      <%= icon "chevron-down", class: "size-4 @3xl:size-4.5 shrink-0 -mr-0.75 in-toggle-has-open-dropdown:rotate-180 transition-all duration-120" %>
    </button>

    <div class="dropdown-menu dropdown-hidden translate-y-0.75" data-dropdown-target="menu">
      <% @search_scopes.each do |scope| %>
        <% scope_selected = scope == @search_scope %>

        <%= link_to search_path({ q: @query, scope: }.compact_blank), class: [ "dropdown-option", "dropdown-option-secondary", "dropdown-option-selected": scope_selected ] do %>
          <%= icon scope_selected ? "#{scope_icons[scope]}-filled" : scope_icons[scope], class: "size-4 shrink-0" %>
          <span><%= scope.titlecase %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @search_scope == "job_leads" %>
    <%= render "shared/filter_dropdown",
      filters: @job_lead_filters,
      name: :status,
      icon_name: "timeline",
      context: "search-status",
      inline: true,
      clearable: false,
      extra_params: search_params,
      options: @statuses.map { |status| { value: status, icon: icon_name_for_status(status) } }
    %>
  <% elsif @search_scope == "interviews" %>
    <%= render "shared/filter_dropdown",
      filters: @interview_filters,
      name: :timeframe,
      icon_name: "date-time",
      context: "search-timeframe",
      inline: true,
      clearable: false,
      extra_params: search_params,
      options: @timeframes.map { |timeframe| { value: timeframe, icon: timeframe_icons[timeframe] } }
    %>

    <%= render "shared/rating_dropdown",
      filters: @interview_filters,
      context: "search-rating",
      inline: true,
      clearable: false,
      extra_params: search_params %>
  <% elsif @search_scope == "notes" %>
    <%= render "shared/filter_dropdown",
      filters: @note_filters,
      name: :notable_type,
      label: "Type",
      icon_name: "question-circle",
      context: "search-type",
      inline: true,
      clearable: false,
      extra_params: search_params,
      options: @notable_types.map { |type| { value: type, label: human(type).pluralize.titleize, icon: notable_type_icons[type] } }
    %>
  <% end %>
</div>
