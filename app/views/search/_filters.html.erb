<%# locals: () %>

<%# Two-column label/options grid: right-aligned labels, wrapping options. %>
<div id="search-filters" class="mt-3 filter-grid">
  <div class="filter-group">
    <%= filter_row_label "Search In", icon_name: "search" %>

    <div class="filter-options">
      <% scope_icons = { all: "layers", job_leads: "briefcase", interviews: "interview", notes: "quill" }.stringify_keys %>

      <% @search_scopes.each do |scope| %>
        <%= render "filter_radio", name: :scope, value: scope, checked: @search_scope == scope, icon_name: scope_icons[scope], context: "search-scope" %>
      <% end %>
    </div>
  </div>

  <% if @search_scope == 'job_leads' %>
    <div class="filter-group">
      <%= filter_row_label "Status", icon_name: "timeline" %>

      <div class="filter-options">
        <%= link_to 'Clear', search_path(@job_lead_filters.params_with(q: @query, scope: @search_scope, status: nil)), class: 'btn btn-sm btn-destructive btn-muted' if @job_lead_filters.filtered?(:status) %>

        <% @statuses.each do |status| %>
          <%= render "filter_radio", name: :status, value: status, checked: @job_lead_filters.status == status, icon_name: icon_name_for_status(status), context: "job-leads-filter-status" %>
        <% end %>
      </div>
    </div>
  <% elsif @search_scope == 'interviews' %>
    <div class="filter-group">
      <%= filter_row_label "Timeframe", icon_name: "date-time" %>

      <div class="filter-options">
        <%= link_to 'Clear', search_path(@interview_filters.params_with(q: @query, scope: @search_scope, timeframe: nil)), class: 'btn btn-sm btn-destructive btn-muted' if @interview_filters.filtered?(:timeframe) %>

        <% timeframe_icons = { upcoming: "time-schedule", completed: "check-circle" }.stringify_keys %>
        <% @timeframes.each do |timeframe| %>
          <%= render "filter_radio", name: :timeframe, value: timeframe, checked: @interview_filters.timeframe == timeframe, icon_name: timeframe_icons[timeframe], context: "interviews-filter-timeframe" %>
        <% end %>
      </div>
    </div>

    <div class="filter-group">
      <%= filter_row_label "Rating", icon_name: "thumbs-up-down" %>

      <div class="filter-options">
        <%= link_to 'Clear', search_path(@interview_filters.params_with(q: @query, scope: @search_scope, rating: nil)), class: 'btn btn-sm btn-destructive btn-muted' if @interview_filters.filtered?(:rating) %>

        <label class="star-none-toggle [view-transition-name:interviews-filter-no-rating]" title="No rating">
          <%= radio_button_tag :rating, "unrated", @interview_filters.rating == "unrated", class: "peer", data: { action: "change->auto-submit#submit" }, aria: { label: "Filter by no rating" } %>
          <%= icon @interview_filters.rating == "unrated" ? "star-slash-filled" : "star-slash" %>
        </label>

        <span class="mx-1 w-px h-6 translate-y-px rounded-full shrink-0 bg-neutral-200 dark:bg-neutral-800" aria-hidden="true"></span>

        <div class="stars-filter-group [view-transition-name:interviews-filter-stars-rating]" role="radiogroup" aria-label="Filter by star rating">
          <% 1.upto(5) do |stars| %>
            <label>
              <%= radio_button_tag :rating, stars, @interview_filters.rating == stars.to_s, data: { action: 'change->auto-submit#submit' }, aria: { label: "Filter by #{pluralize(stars, 'star')}" } %>
              <%= icon "star" %>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif @search_scope == 'notes' %>
    <div class="filter-group">
      <%= filter_row_label "Type", icon_name: "question-circle" %>

      <div class="filter-options">
        <%= link_to 'Clear', search_path(@note_filters.params_with(q: @query, scope: @search_scope, notable_type: nil)), class: 'btn btn-sm btn-destructive btn-muted' if @note_filters.filtered?(:notable_type) %>

        <% notable_type_icons = { JobLead: "briefcase", Interview: "interview" }.stringify_keys %>
        <% @notable_types.each do |notable_type| %>
          <%= render "filter_radio", name: :notable_type, value: notable_type, checked: @note_filters.notable_type == notable_type, icon_name: notable_type_icons[notable_type], label: human(notable_type).pluralize.titleize, context: "notes-filter-notable-type" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
