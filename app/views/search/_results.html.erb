<%# locals: () %>

<% any_results = @results[:job_leads].any? || @results[:interviews].any? || @results[:notes].any? %>

<%= turbo_frame_tag 'search-results' do %>
  <div class="@container <%= 'mt-6' if @search_scope.present? && @search_scope != 'all' %>">
    <% if @query.blank? %>
      <div class="empty-state [view-transition-name:search-empty]">
        Start typing to find your job leads, interviews, or notes.
      </div>
    <% elsif any_results %>
      <% if @results[:job_leads].any? %>
        <% unless @search_scope == 'job_leads' %>
          <p class="ml-1 font-semibold mt-10 mb-2 border-b border-neutral-200 dark:border-neutral-800 pb-1">
            <%= pluralize @results[:job_leads].count, "Job Lead" %>
          </p>
        <% end %>

        <div class="<%= collection_layout_class_names :job_leads, count: @results[:job_leads].size, size: :large %>">
          <% @results[:job_leads].each do |job_lead| %>
            <%= render job_lead %>
          <% end %>
        </div>
      <% end %>

      <% if @results[:interviews].any? %>
        <% unless @search_scope == 'interviews' %>
          <p class="ml-1 font-semibold mt-10 mb-2 border-b border-neutral-200 dark:border-neutral-800 pb-1">
            <%= pluralize @results[:interviews].count, "Interview" %>
          </p>
        <% end %>

        <div class="<%= collection_layout_class_names :interviews, count: @results[:interviews].size, size: :large %>">
          <% @results[:interviews].each do |interview| %>
            <%= render interview %>
          <% end %>
        </div>
      <% end %>

      <% if @results[:notes].any? %>
        <% unless @search_scope == 'notes' %>
          <p class="ml-1 font-semibold mt-10 mb-2 border-b border-neutral-200 dark:border-neutral-800 pb-1">
            <%= pluralize @results[:notes].count, "Note" %>
          </p>
        <% end %>
        <div class="<%= collection_layout_class_names :notes, count: @results[:notes].size, size: :large %>">
          <% @results[:notes].each do |note| %>
            <%= render note %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state [view-transition-name:search-empty]">
        <span>
          <%= search_empty_results_text @search_scope, query: @query, status: @job_lead_filters.status, timeframe: @interview_filters.timeframe, rating: @interview_filters.rating, notable: @note_filters.notable_type %>
        </span>
      </div>
    <% end %>
  </div>
<% end %>
